# --- Data: raw inputs are downloaded or hand-entered and are NEVER committed.
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
# data/extracted/ IS committed: Claude-extracted published values with sources,
# so the researcher's verification flips are tracked.

# --- Generated outputs: regenerated by `make all`, never edited by hand.
results/figures/*
results/tables/*
results/logs/*
results/validation/*
!results/**/.gitkeep

# --- Simulated data files are regenerated by the scripts in sim/; only the
# scripts are committed.
sim/**/*.csv
sim/**/*.parquet
sim/**/*.rds

# --- Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- R (renv manages renv/.gitignore for its own library)
.Rhistory
.RData
.Rproj.user/

# --- OS / editors
.DS_Store
*.swp
